# Local development secrets template
# Copy to deploy/secrets.local.yaml (which is gitignored) and replace placeholders.

store:
  secrets:
    mariadbRootPassword: "root_dev_password_change_me"
    mariadbPassword: "wp_dev_password_change_me"
    wpAdminUser: "admin"
    wpAdminPassword: "wp_admin_password_change_me"
    wpAdminEmail: "admin@store.local"
    wcConsumerKey: "ck_dev_change_me"
    wcConsumerSecret: "cs_dev_change_me"

gateway:
  secrets:
    postgresPassword: "gateway_db_password_change_me"
    # 32 bytes base64 key for AES-256-GCM data encryption (e.g. openssl rand -base64 32)
    dataKey: "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
    seedAdminPassword: "admin_password_change_me"
    seedMemberPassword: "member_password_change_me"
    # OpenAI-compatible LLM credentials (optional; returns clear 503 if LLM_API_KEY is empty)
    llmBaseUrl: "https://api.openai.com/v1"
    llmApiKey: ""
    llmModel: "gpt-4o-mini"
